# FitHub Gym Management System
# Environment Configuration Template
# Copy this file to .env and update with your settings

# Application Environment (development or production)
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_NAME=fithub_gym
DB_USER=root
DB_PASS=

# Application Settings
APP_NAME="FitHub Gym Management System"
APP_URL=http://localhost/

# Gym Information
GYM_NAME="FitHub Fitness Center"
GYM_EMAIL="info@fithub.com"
GYM_PHONE="+91-9876543210"
GYM_ADDRESS="123 Fitness Street, Health City, HC 12345"

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
SMTP_FROM_EMAIL=noreply@fithub.com
SMTP_FROM_NAME="FitHub System"

# SMS Configuration (Optional - for notifications)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=FITHUB

# Security Settings
SESSION_LIFETIME=1800
BCRYPT_COST=10

# Timezone
TIMEZONE=Asia/Kolkata
