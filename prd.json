{
  "project": {
    "name": "Simple Gym Management System",
    "version": "1.0.0",
    "description": "A beginner-friendly gym management system with basic member management, simple attendance tracking, and easy-to-use interface.",
    "tech_stack": {
      "frontend": ["HTML5", "CSS3", "Basic JavaScript", "Bootstrap 5"],
      "backend": ["PHP 7.4+", "MySQL 5.7+", "MySQLi"],
      "server": "XAMPP/WAMP/LAMP"
    }
  },
  "design_system": {
    "framework": "Bootstrap 5",
    "colors": {
      "primary": "#007bff",
      "secondary": "#6c757d",
      "success": "#28a745",
      "danger": "#dc3545",
      "warning": "#ffc107",
      "info": "#17a2b8"
    },
    "typography": {
      "font_family": "Bootstrap default (system fonts)",
      "headings": "Bootstrap heading classes",
      "body": "Bootstrap default"
    }
  },
  "user_roles": {
    "admin": {
      "permissions": [
        "manage_members",
        "view_attendance",
        "basic_reports"
      ]
    }
  },
  "database_schema": {
    "tables": {
      "members": {
        "id": {"type": "INT", "primary_key": true, "auto_increment": true},
        "name": {"type": "VARCHAR(100)"},
        "email": {"type": "VARCHAR(100)"},
        "phone": {"type": "VARCHAR(15)"},
        "join_date": {"type": "DATE"},
        "membership_type": {"type": "VARCHAR(50)"},
        "status": {"type": "VARCHAR(20)", "default": "active"}
      },
      "attendance": {
        "id": {"type": "INT", "primary_key": true, "auto_increment": true},
        "member_id": {"type": "INT", "foreign_key": "members.id"},
        "date": {"type": "DATE"},
        "check_in": {"type": "TIME"},
        "check_out": {"type": "TIME", "nullable": true}
      }
    }
  },
  "core_modules": {
    "member_management": {
      "list_page": {
        "display": ["name", "email", "phone", "membership_type", "status"],
        "actions": ["add", "edit", "delete", "view"]
      },
      "add_edit_form": {
        "fields": ["name", "email", "phone", "membership_type"],
        "validation": ["required_fields", "email_format"]
      }
    },
    "attendance_tracking": {
      "check_in_system": {
        "search": ["member_name"],
        "actions": ["check_in", "check_out"]
      },
      "reports": {
        "views": ["daily_attendance", "member_attendance"]
      }
    }
  },
  "file_structure": {
    "pages": [
      "index.php",
      "members.php",
      "attendance.php",
      "reports.php"
    ],
    "includes": [
      "config.php",
      "functions.php"
    ]
  },
  "security_requirements": {
    "sql_injection_prevention": "MySQLi prepared statements",
    "xss_prevention": "htmlspecialchars() on outputs",
    "basic_validation": "Required fields, email format"
  },
  "validation_rules": {
    "email": "Valid format",
    "phone": "10 digits",
    "name": "Required field"
  },
  "external_libraries": {
    "required": [
      "Bootstrap 5"
    ]
  },
  "development_phases": {
    "phase_1": {
      "name": "Basic Setup",
      "duration": "Week 1",
      "tasks": [
        "Database setup",
        "Basic configuration",
        "Homepage with navigation"
      ]
    },
    "phase_2": {
      "name": "Member Management",
      "duration": "Week 2",
      "tasks": [
        "Add member form",
        "List members",
        "Edit/Delete members"
      ]
    },
    "phase_3": {
      "name": "Attendance System",
      "duration": "Week 3",
      "tasks": [
        "Check-in system",
        "Attendance list",
        "Basic reports"
      ]
    }
  },
  "testing_scenarios": [
    "Add new member",
    "Check-in member",
    "View attendance list",
    "Basic form validation"
  ],
  "deployment_requirements": {
    "server": "XAMPP/WAMP/LAMP",
    "database": "MySQL 5.7+",
    "php_version": "7.4+"
  }
}
